{
  "name": "pig_bank_card_microservice",
  "version": "1.0.0",
  "description": "",
  "main": "dist/handler.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "bundle": "esbuild src/infra/handlers/*.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --external:@aws-sdk/*",
    "build": "tar -a -c -f lambda.zip dist package.json",
	"compile": "run-s bundle build",
	"tf:init": "terraform init",
	"tf:apply": "terraform apply -auto-approve",
	"deploy:init": "run-s compile tf:init tf:apply",
	"deploy": "run-s compile tf:apply"
  },
  "tsc-alias": {
    "verbose": false,
    "resolveFullPaths": true
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1003.0",
    "@aws-sdk/client-s3": "^3.1003.0",
    "@aws-sdk/client-sqs": "^3.1003.0",
    "@aws-sdk/lib-dynamodb": "^3.1003.0",
    "@aws-sdk/s3-request-presigner": "^3.1003.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.3.5",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
